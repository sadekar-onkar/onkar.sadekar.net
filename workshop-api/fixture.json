 "categories": [
  {
   "id": "c01",
   "label": "Plant-knowledge sharing and cumulative cultural evolution",
   "short": "P1 · Plant knowledge",
   "description": "Examine how friendship, kinship and contact networks shape the transmission, recombination and innovation of medicinal plant knowledge.",
   "live": false
  },
  {
   "id": "c02",
   "label": "Reputation, gossip, antagonistic ties, and cooperation",
   "short": "P2 · Reputation",
   "description": "Test whether gossip over positive and antagonistic ties spreads reputations through camps and explains cooperation beyond kinship or residence.",
   "live": false
  },
  {
   "id": "c03",
   "label": "Mental health, well-being, and sex differences",
   "short": "P3 · Mental health",
   "description": "Investigate how egalitarian social settings and social-support networks shape mental health and well-being across life history.",
   "live": false
  },
  {
   "id": "c04",
   "label": "Lifestyle transition, cultural repertoire and social inequality",
   "short": "P4 · Inequality",
   "description": "Study how possessions and skills are distributed by gender, and how inequality emerges as hunter-gatherers settle into agriculture and/or get in conflict with farmers.",
   "live": false
  },
  {
   "id": "c05",
   "label": "Lifetime mobility and socio-cultural patterns",
   "short": "P5 · Lifetime mobility",
   "description": "Reconstruct networks from lifetime residence and visiting histories to show who moves, when and with whom, and how this shapes anthropologically interesting features.",
   "live": false
  },
  {
   "id": "c06",
   "label": "Friendship, co-location and multiplex social networks",
   "short": "P6/7 · Multiplex networks",
   "description": "Pair ~9 weeks of wearable proximity data with app-reported ties to study how friendships form, persist and structure daily co-location — and use information theory to test how much the kinship, friendship, contact and mobility layers overlap, and in which direction.",
   "live": false
  },
  {
   "id": "c07",
   "label": "Mobility, social networks and disease ecology",
   "short": "P8 · Disease ecology",
   "description": "Explore how marriage, migration and contact networks shape genetic connectivity, adaptation and infection risk, including a trade-off with cultural transmission.",
   "live": false
  },
  {
   "id": "c08",
   "label": "Language evolution and story-telling",
   "short": "P9 · Language & stories",
   "description": "Track how stories, songs and ritual performances are learned, transmitted and transformed across networks, generations and regions.",
   "live": false
  },
  {
   "id": "c09",
   "label": "Scaling laws from camps to towns",
   "short": "P10 · Scaling laws",
   "description": "Test whether contacts per person scale with settlement size, from forest camps to towns, and whether size or permanence matters.",
   "live": false
  },
  {
   "id": "c10",
   "label": "Interventions and social diffusion",
   "short": "P11 · Interventions",
   "description": "Seed culturally relevant health or social interventions in selected people to test whether network-based targeting outperforms random seeding.",
   "live": false
  }
 ],
